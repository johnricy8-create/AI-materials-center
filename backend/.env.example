APP_NAME=AI Asset Hub
ENVIRONMENT=development
DEBUG=true

# SQLite (temporary M1)
DATABASE_URL=sqlite+aiosqlite:///./data/asset_hub.db
STORAGE_DIR=../storage

MAX_UPLOAD_MB=25
MAX_FILES_PER_REQUEST=10
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173

# Zhipu GLM (OpenAI-compatible)
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_API_KEY=
GLM_MODEL=glm-4.7-flash
GLM_FALLBACK_MODEL=glm-4-flash-250414
GLM_VISION_MODEL=glm-4v-flash
EMBEDDING_MODEL=embedding-3
EMBEDDING_DIM=1024
GLM_TIMEOUT_SECONDS=30
GLM_MAX_RETRIES=1
# 本地无 Key 或跑测试时设为 true
USE_MOCK_AI=false
